<!DOCTYPE html>
<html lang="ur">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BLACKIA - نیا اکاؤنٹ بنائیں</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .container {
            width: 100%;
            max-width: 450px;
        }

        .signup-box {
            background: rgba(20, 20, 20, 0.95);
            border: 2px solid #d4af37;
            border-radius: 15px;
            padding: 35px;
            box-shadow: 0 8px 32px rgba(212, 175, 55, 0.2);
        }

        .logo {
            text-align: center;
            margin-bottom: 25px;
        }

        .logo h1 {
            color: #d4af37;
            font-size: 28px;
            font-weight: bold;
        }

        .tagline {
            color: #bbb;
            font-size: 12px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            color: #d4af37;
            font-size: 13px;
            margin-bottom: 6px;
            font-weight: 500;
        }

        input {
            width: 100%;
            padding: 10px;
            border: 1px solid #d4af37;
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
            font-size: 13px;
        }

        input:focus {
            outline: none;
            border-color: #ffaa00;
            background: rgba(212, 175, 55, 0.1);
        }

        .signup-btn {
            width: 100%;
            padding: 11px;
            background: linear-gradient(135deg, #d4af37 0%, #ffaa00 100%);
            color: #1a1a1a;
            border: none;
            border-radius: 6px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
        }

        .signup-btn:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(212, 175, 55, 0.4);
        }

        .login-link {
            text-align: center;
            color: #aaa;
            font-size: 13px;
            margin-top: 15px;
        }

        .login-link a {
            color: #d4af37;
            text-decoration: none;
        }

        .error-message {
            background: rgba(220, 53, 69, 0.15);
            color: #ff6b6b;
            padding: 10px;
            border-radius: 6px;
            margin-bottom: 15px;
            font-size: 12px;
            display: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="signup-box">
            <div class="logo">
                <h1>BLACKIA</h1>
                <p class="tagline">Step Into Style</p>
            </div>

            <div class="error-message" id="errorMessage"></div>

            <form id="signupForm">
                <div class="form-group">
                    <label>مکمل نام</label>
                    <input type="text" id="fullName" placeholder="آپ کا نام" required>
                </div>

                <div class="form-group">
                    <label>ای میل</label>
                    <input type="email" id="email" placeholder="آپ کا ای میل" required>
                </div>

                <div class="form-group">
                    <label>پاس ورڈ</label>
                    <input type="password" id="password" placeholder="قوی پاس ورڈ" required>
                </div>

                <div class="form-group">
                    <label>پاس ورڈ کی تصدیق</label>
                    <input type="password" id="confirmPassword" placeholder="پاس ورڈ دوبارہ" required>
                </div>

                <button type="submit" class="signup-btn">اکاؤنٹ بنائیں</button>
            </form>

            <div class="login-link">
                پہلے سے اکاؤنٹ ہے؟ <a href="login.html">لاگ ان کریں</a>
            </div>
        </div>
    </div>

    <script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-auth.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-firestore.js"></script>

    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyB4NUuBGGDDignA55z_IfNU78e7l2-T3vE",
            authDomain: "blckiashoes.firebaseapp.com",
            projectId: "blckiashoes",
            storageBucket: "blckiashoes.firebasestorage.app",
            messagingSenderId: "264597463698",
            appId: "1:264597463698:web:aa7eee5cca0f1bbd547c4b"
        };

        const app = firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();
        const db = firebase.firestore();

        document.getElementById('signupForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const fullName = document.getElementById('fullName').value;
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const errorMessage = document.getElementById('errorMessage');

            if (password !== confirmPassword) {
                errorMessage.textContent = '❌ پاس ورڈ match نہیں کر رہے';
                errorMessage.style.display = 'block';
                return;
            }

            if (password.length < 6) {
                errorMessage.textContent = '❌ پاس ورڈ کم از کم 6 حروف ہونا چاہیے';
                errorMessage.style.display = 'block';
                return;
            }

            try {
                const userCredential = await auth.createUserWithEmailAndPassword(email, password);
                const user = userCredential.user;

                await db.collection('customers').doc(user.uid).set({
                    uid: user.uid,
                    fullName: fullName,
                    email: email,
                    phoneNumber: '',
                    address: '',
                    city: '',
                    country: '',
                    postalCode: '',
                    profileImageUrl: '',
                    createdAt: new Date(),
                    updatedAt: new Date(),
                    isActive: true,
                    emailVerified: false,
                    accountStatus: 'active'
                });

                alert('✅ اکاؤنٹ کامیابی سے بنایا گیا! براہ کرم لاگ ان کریں۔');
                window.location.href = 'login.html';
            } catch (error) {
                errorMessage.style.display = 'block';
                if (error.code === 'auth/email-already-in-use') {
                    errorMessage.textContent = '❌ یہ ای میل پہلے سے استعمال میں ہے';
                } else if (error.code === 'auth/invalid-email') {
                    errorMessage.textContent = '❌ غلط ای میل فارمیٹ';
                } else {
                    errorMessage.textContent = '❌ اکاؤنٹ بنانے میں خرابی';
                }
            }
        });
    </script>
</body>
</html>
